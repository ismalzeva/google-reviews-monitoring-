# GRM environment template — copy to .env and fill real values.
# NEVER commit secrets. All values below are placeholders.

# ── App ────────────────────────────────────────────────────
FLASK_ENV=development
SECRET_KEY=change-me
APP_PORT=8083

# ── Database ───────────────────────────────────────────────
# DATABASE_URL=postgresql://grm:CHANGE_ME@localhost:5434/grm_db

# ── Public Review Provider (RUN_10/RUN_11) ────────────────
# mock | outscraper | apify  (mock = deterministic test dataset, no API needed)
# ROLLBACK: set back to mock + restart to disable live provider (no silent fallback)
PUBLIC_REVIEW_PROVIDER=mock
# Required when PUBLIC_REVIEW_PROVIDER=outscraper (from Outscraper dashboard)
# NEVER commit a real value; never paste it into chat/reports/logs.
OUTSCRAPER_API_KEY=
PUBLIC_REVIEW_TIMEOUT=30
PUBLIC_REVIEW_MAX_RETRIES=3
PUBLIC_REVIEW_PAGE_SIZE=50
PUBLIC_REVIEW_MAX_REVIEWS=100

# ── Apify provider (RUN_11) ────────────────────────────────
# Required when PUBLIC_REVIEW_PROVIDER=apify (token from Apify Console
# API & Integrations). NEVER commit/paste/log the token.
APIFY_API_TOKEN=
APIFY_REVIEW_ACTOR_ID=compass/google-maps-reviews-scraper
APIFY_DISCOVERY_ACTOR_ID=compass/crawler-google-places
APIFY_TIMEOUT_SECONDS=8
APIFY_POLL_INTERVAL_SECONDS=3
APIFY_MAX_RETRIES=3
APIFY_MAX_REVIEWS=100
APIFY_MAX_PLACES=10
# Optional Apify Task ids (production later)
# APIFY_REVIEW_TASK_ID=
# APIFY_DISCOVERY_TASK_ID=

# ⚠️ Pilot Place ID (ChIJ0-depok-margonda-001) pada docs/checklist adalah
# CONTOH/placeholder dari dataset mock — BUKAN Place ID asli. Sebelum live
# sync: discovery nyata dulu, verifikasi Maps URL + Place ID + nama/alamat/kota/rating.

# ── Pilot / Safety (do not enable without explicit instruction) ──
GRM_PILOT_MODE=true
# RUN_11 live pilot: strictly ONE active outlet. Raise only via a RUN decision.
GRM_PILOT_MAX_OUTLETS=1
GRM_AUTO_REPLY_ENABLED=false
GRM_REPLY_ENABLED_GLOBAL=false
# Master switch for optional "GRM Manage" (Google OAuth connect/callback/
# account/location/reconciliation + reply draft/approval/publish/moderation).
# OFF by default. When false, app/routes/google.py and app/routes/response.py
# are NOT registered at all (404) — independent of GOOGLE_CLIENT_ID/SECRET.
# Do NOT set to true without an explicit owner decision (GRM_PRODUCT_MASTER
# skill §3). See app/services/feature_flags.py::is_grm_manage_enabled.
GRM_MANAGE_ENABLED=false
