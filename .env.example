# Google Reviews Monitoring — Environment Template
# Copy to .env and fill in real values
# NEVER commit .env to git

SECRET_KEY=generate-random-32-char-hex
DATABASE_URL=postgresql://user:***@host:5432/dbname
APP_PORT=8083
APP_NAME=Google Reviews Monitoring
SESSION_LIFETIME_HOURS=24

# === Google OAuth (kosongkan = mock adapter / development) ===
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Redirect URI must match Google Cloud Console → Authorized redirect URIs
GOOGLE_REDIRECT_URI=http://localhost:8083/google/callback

# === Google Business Profile API ===
# Base URL for GBP API v4 (usually default, override if needed)
GBP_API_BASE_URL=https://businessprofile.googleapis.com/v1

# === Pub/Sub (Google Cloud Pub/Sub) ===
# GCP project where Pub/Sub is configured
GCP_PROJECT_ID=
# Topic for review events (NEW_REVIEW / UPDATED_REVIEW)
PUBSUB_TOPIC=
# Subscription name
PUBSUB_SUBSCRIPTION=
# Service account JSON path for Pub/Sub subscriber (optional, for push auth)
PUBSUB_SERVICE_ACCOUNT_JSON=

# === Pilot Mode ===
# true = limit outlets, lock auto-reply, require approval
GRM_PILOT_MODE=true
# Max active outlets per tenant in pilot (default 1)
GRM_PILOT_MAX_OUTLETS=1
# Comma-separated outlet IDs or names to whitelist (empty = auto-pick first)
GRM_PILOT_OUTLET_WHITELIST=

# === Global Switches (OFF by default, ON only after pilot validates) ===
GRM_AUTO_REPLY_ENABLED=false
GRM_REPLY_ENABLED_GLOBAL=false
